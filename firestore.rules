rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Google accounts that may read and reply to every conversation.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['quangthong3005@gmail.com'];
    }
    // Owner, or anyone the owner added on the admin page (editors collection).
    function isAdmin() {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/editors/$(request.auth.token.email)));
    }

    // One conversation per visitor. The document id is the visitor's anonymous user id.
    match /chats/{chatId} {
      allow get: if request.auth != null && (request.auth.uid == chatId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null && (request.auth.uid == chatId || isAdmin());

      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == chatId || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && ((request.auth.uid == chatId && request.resource.data.from == 'customer')
              || (isAdmin() && request.resource.data.from == 'band'));
      }
    }

    // Gallery photos: everyone can see them, only band admins can add / change / remove.
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.src is string
        && request.resource.data.src.size() < 950000
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 80;
      allow update: if isAdmin()
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 80;
      allow delete: if isAdmin();
    }

    // Extra editors (email = document id). Only the owner manages this list.
    match /editors/{email} {
      allow read: if request.auth != null && (isOwner() || request.auth.token.email == email);
      allow write: if isOwner();
    }

    // Videos shown on the website (YouTube id + title). Everyone reads, admins manage.
    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && (!('ytId' in request.resource.data) || (request.resource.data.ytId is string && request.resource.data.ytId.size() <= 20))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 100));
      allow delete: if isAdmin();
    }

    // Band member details that override or extend the built-in list.
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && (!('role' in request.resource.data) || request.resource.data.role.size() <= 60)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 600)
        && (!('portfolio' in request.resource.data) || request.resource.data.portfolio.size() <= 300)
        && (!('photo' in request.resource.data) || request.resource.data.photo.size() < 950000);
      allow delete: if isAdmin();
    }

    // Editable website texts (document id: texts).
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
